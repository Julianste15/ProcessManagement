# Copia este archivo a .env antes de levantar Docker Compose:
#   cp .env.example .env
#
# .env esta en .gitignore: nunca lo subas al repositorio.

# Firma de los JWT (obligatorio).
# Genera una cadena aleatoria de al menos 32 caracteres, por ejemplo:
#   openssl rand -base64 48
JWT_SECRET=

# Origenes permitidos por CORS en el gateway (separados por coma).
# El cliente JavaFX no usa CORS; solo aplica a clientes web o Swagger.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Remitente de las notificaciones. El envio actual es simulado (solo logs).
NOTIFICATION_EMAIL_FROM=notificaciones@unicauca.edu.co
